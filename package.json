{
  "name": "ultra-mcp-toolkit",
  "version": "0.6.0",
  "description": "Shared toolkit for building token-efficient Model Context Protocol (MCP) servers — operation manifest, response trimming, disk sandbox, code-api/CLI bridge, SKILL.md installer.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./manifest": {
      "types": "./build/core/manifest.d.ts",
      "import": "./build/core/manifest.js"
    },
    "./sandbox": {
      "types": "./build/core/sandbox.d.ts",
      "import": "./build/core/sandbox.js"
    },
    "./page-cache": {
      "types": "./build/core/page-cache.d.ts",
      "import": "./build/core/page-cache.js"
    },
    "./trim": {
      "types": "./build/core/trim.d.ts",
      "import": "./build/core/trim.js"
    },
    "./trim-registry": {
      "types": "./build/core/trim-registry.d.ts",
      "import": "./build/core/trim-registry.js"
    },
    "./bridge": {
      "types": "./build/bridge/index.d.ts",
      "import": "./build/bridge/index.js"
    },
    "./code-api": {
      "types": "./build/code-api/index.d.ts",
      "import": "./build/code-api/index.js"
    },
    "./cli": {
      "types": "./build/cli/index.d.ts",
      "import": "./build/cli/index.js"
    },
    "./client": {
      "types": "./build/client/index.d.ts",
      "import": "./build/client/index.js"
    },
    "./config": {
      "types": "./build/config/index.d.ts",
      "import": "./build/config/index.js"
    },
    "./toon": {
      "types": "./build/core/toon.d.ts",
      "import": "./build/core/toon.js"
    },
    "./tool": {
      "types": "./build/tool/dispatcher.d.ts",
      "import": "./build/tool/dispatcher.js"
    },
    "./schemas": {
      "types": "./build/schemas/index.d.ts",
      "import": "./build/schemas/index.js"
    },
    "./http-client": {
      "types": "./build/client/http.d.ts",
      "import": "./build/client/http.js"
    },
    "./transport": {
      "types": "./build/client/transport.d.ts",
      "import": "./build/client/transport.js"
    },
    "./streaming": {
      "types": "./build/client/streaming.d.ts",
      "import": "./build/client/streaming.js"
    },
    "./lru": {
      "types": "./build/core/lru.d.ts",
      "import": "./build/core/lru.js"
    },
    "./disk-cache": {
      "types": "./build/core/disk-cache.d.ts",
      "import": "./build/core/disk-cache.js"
    },
    "./mutation-ack": {
      "types": "./build/trim/mutation-ack.d.ts",
      "import": "./build/trim/mutation-ack.js"
    },
    "./stdio": {
      "types": "./build/boot/stdio.d.ts",
      "import": "./build/boot/stdio.js"
    },
    "./agent-safety": {
      "types": "./build/agent-safety/index.d.ts",
      "import": "./build/agent-safety/index.js"
    },
    "./agent-tools": {
      "types": "./build/agent-tools/index.d.ts",
      "import": "./build/agent-tools/index.js"
    }
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "scripts/install-skill.mjs",
    ".claude/skills/ultra-mcp-toolkit/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "clean": "rm -rf build",
    "install-skill": "node scripts/install-skill.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "toolkit",
    "token-efficient",
    "ai",
    "claude",
    "trim",
    "sandbox",
    "code-api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "undici": "^6.25.0"
  },
  "peerDependencies": {
    "@octokit/rest": "^22.0.0",
    "ai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@octokit/rest": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@octokit/rest": "^22.0.1",
    "@types/node": "^25.6.0",
    "ai": "^6.0.182",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
